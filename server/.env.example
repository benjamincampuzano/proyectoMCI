# Database (Supabase)
# DATABASE_URL = transaction pooler (runtime). Generado en Settings → Database → Connection string
# Usa el pooler de transacciones (puerto 6543) con ?pgbouncer=true para IPv4-only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = session-mode/direct connection, usada por `prisma migrate` y el backup (pg_dump).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="production"

# CORS (optional)
FRONTEND_URL="https://your-railway-app-url.railway.app"

# Backup Encryption (AES-256-GCM)
# Used to encrypt database backups before download. Minimum 16 characters.
# IMPORTANT: If you lose this key, existing encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key-min-16-chars"

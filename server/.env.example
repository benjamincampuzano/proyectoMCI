# Database
# Add connection_limit and pool_timeout to prevent pool exhaustion
# Format: postgresql://user:pass@host:port/db?connection_limit=20&pool_timeout=20
DATABASE_URL="postgresql://username:password@host:port/database?connection_limit=20&pool_timeout=20"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="production"

# CORS (optional)
FRONTEND_URL="https://your-railway-app-url.railway.app"

# Backup Encryption (AES-256-GCM)
# Used to encrypt database backups before download. Minimum 16 characters.
# IMPORTANT: If you lose this key, existing encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key-min-16-chars"

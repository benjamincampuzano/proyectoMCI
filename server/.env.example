# Database (PostgreSQL)
# DATABASE_URL = pooled connection (runtime, via PrismaPg driver adapter).
#   Desarrollo local (PostgreSQL 16 en el 5433, ver docs/DB_LOCAL.md):
DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5433/iglesia"
# DIRECT_URL = direct connection, used by `prisma migrate` and backups (pg_dump).
DIRECT_URL="postgresql://postgres:<password>@127.0.0.1:5433/iglesia"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Rate Limiting de códigos de servidor (módulo Servidores)
# El endpoint público de validación de código está limitado por IP para evitar
# la enumeración por fuerza bruta del espacio de 900.000 códigos.
CODE_VALIDATION_RATE_LIMIT_MAX="20"
CODE_VALIDATION_RATE_LIMIT_WINDOW_MS="900000"   # 15 minutos
# Creación de códigos (usuarios autenticados)
SERVER_CREATE_RATE_LIMIT_MAX="20"
SERVER_CREATE_RATE_LIMIT_WINDOW_MS="3600000"   # 1 hora

# Cookies de sesión (access token en memoria + refresh token en cookie HttpOnly)
# SameSite de la cookie: strict | lax | none | auto (por defecto "auto":
# "none" si la API y el front están en orígenes distintos, "strict" si no).
# "none" exige COOKIE_SECURE=true.
COOKIE_SAME_SITE="auto"
# Secure: por defecto true en producción (NODE_ENV=production) y false en local.
# COOKIE_SECURE="true"
# Secreto para firmar el token CSRF (double submit). Si no se define se usa JWT_SECRET.
# CSRF_SECRET="otro-secreto-aleatorio"

# Server
PORT=5000
NODE_ENV="production"

# CORS (optional)
FRONTEND_URL="https://your-railway-app-url.railway.app"

# Backup Encryption (AES-256-GCM)
# Used to encrypt database backups before download. Minimum 16 characters.
# IMPORTANT: If you lose this key, existing encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key-min-16-chars"
